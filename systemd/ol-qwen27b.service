[Unit]
Description=Ollama 27B 128K (GPU 3 / GPU-a6a2e073)
After=network-online.target

[Service]
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="PATH=/usr/local/cuda/bin:/usr/local/bin:/root/openmpi-5.0.8:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="OLLAMA_HOST=0.0.0.0:11436"
Environment="OLLAMA_ORIGINS=*"
Environment="OLLAMA_MODELS=/mnt/ollama_models"
Environment="OLLAMA_CONTEXT_LENGTH=131072"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_KEEP_ALIVE=24h"
Environment="OLLAMA_MAX_QUEUE=64"
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="GGML_VK_VISIBLE_DEVICES=3"
ExecStart=/usr/local/bin/ollama serve

[Install]
WantedBy=multi-user.target
