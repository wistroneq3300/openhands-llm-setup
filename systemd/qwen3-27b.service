[Unit]
Description=vLLM Qwen3.8-27B (TP=2, GPU 4,5, 256K context)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CUDA_VISIBLE_DEVICES=4,5
Environment=VLLM_ATTENTION_BACKEND=FLASH_ATTN
# 2026-09-28: DO NOT REMOVE. Workaround for NVLink SHARP (NVLS) fabric out-of-sync
# on driver 580 (NV_ERR_FABRIC_STATE_OUT_OF_SYNC) after a nvidia-fabricmanager restart:
# vLLM custom-all-reduce / symm_mem fails with "NCCL error: unhandled cuda error".
# Disabling NVLS makes vLLM fall back to plain NCCL (PYNCCL) over healthy NVLink P2P.
# Can only be reverted after a full reboot re-initializes the fabric.
Environment=NCCL_NVLS_ENABLE=0
Environment=VLLM_ALLREDUCE_USE_SYMM_MEM=0
ExecStart=/mnt/venv/bin/vllm serve /mnt/hf-cache/Qwen/Qwen3.8-27B \
    --served-model-name qwen3.8-27b \
    --host 0.0.0.0 \
    --port 8001 \
    --tensor-parallel-size 2 \
    --max-model-len 262144 \
    --gpu-memory-utilization 0.9 \
    --trust-remote-code \
    --disable-custom-all-reduce \
    --enable-auto-tool-choice \
    --tool-call-parser qwen3_coder
Restart=on-failure
RestartSec=30
User=root

[Install]
WantedBy=multi-user.target
