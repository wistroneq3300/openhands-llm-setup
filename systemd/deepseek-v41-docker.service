[Unit]
Description=DeepSeek-V4.1-Flash (vLLM nightly Docker)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 每次啟動前先清掉同名舊容器，避免重開機時 docker 自啟的舊容器
# 與 systemd 的 `docker run --name` 撞名（exit 125）。rm -f 對不存在的
# 容器回 0，安全可重跑。
ExecStartPre=-/usr/bin/docker rm -f deepseek-v41-nightly-test
ExecStart=/usr/bin/docker run -d \
    --name deepseek-v41-nightly-test \
    --restart unless-stopped \
    --gpus '"device=0,1,2,3"' \
    --shm-size=32g \
    -e NCCL_NVLS_ENABLE=0 \
    -e VLLM_ATTENTION_BACKEND=FLASH_ATTN \
    -p 8011:8000 \
    -v /mnt/hf-cache/deepseek-ai/DeepSeek-V4.1-Flash:/models/deepseek-v41-flash:ro \
    -v /var/log/vllm-nightly:/logs \
    -v /opt/v41-patch/apply_patch.sh:/opt/apply_patch.sh \
    --entrypoint /bin/bash \
    vllm/vllm-openai@sha256:cb89f35c700821851e401d0f490470794f3cc40c4fc4ba6316920ae508360fef \
    /opt/apply_patch.sh \
    vllm serve /models/deepseek-v41-flash \
        --served-model-name deepseek-v41-flash \
        --host 0.0.0.0 --port 8000 \
        --tensor-parallel-size 4 \
        --max-model-len 262144 \
        --gpu-memory-utilization 0.9 \
        --kv-cache-dtype fp8 \
        --trust-remote-code \
        --disable-custom-all-reduce \
        --enable-auto-tool-choice \
        --tool-call-parser deepseek_v41 \
        --default-chat-template-kwargs "{\"thinking\":false}"
ExecStop=/usr/bin/docker rm -f deepseek-v41-nightly-test
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
