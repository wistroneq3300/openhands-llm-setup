[Unit]
Description=DeepSeek-V4.1-Flash (vLLM nightly Docker)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker run -d \
    --name deepseek-v41-nightly-test \
    --restart unless-stopped \
    --gpus '"device=0,1,2,3"' \
    --ipc=host \
    -p 8011:8000 \
    -v /mnt/hf-cache/deepseek-ai/DeepSeek-V4.1-Flash:/models/deepseek-v41-flash:ro \
    -v /var/log/vllm-nightly:/logs \
    vllm/vllm-openai:cu134-nightly \
    /models/deepseek-v41-flash \
        --served-model-name deepseek-v41-flash \
        --host 0.0.0.0 --port 8000 \
        --tensor-parallel-size 4 \
        --max-model-len 262144 \
        --gpu-memory-utilization 0.9 \
        --kv-cache-dtype fp8 \
        --trust-remote-code \
        --disable-custom-all-reduce \
        --enable-auto-tool-choice \
        --tool-call-parser deepseek_v41 \
        --default-chat-template-kwargs "{\"thinking\":false}"
ExecStop=/usr/bin/docker rm -f deepseek-v41-nightly-test
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
